{
 "about": "Wire-level cases for the MCP server, run by test/mcp-conformance.test.ts over Streamable HTTP and stdio. 'spec' cases follow a requirement of the cited revision; 'choice' cases are behaviour the specification leaves open, which this server fixes. docs/mcp-conformance.md lists them.",
 "cases": [
  {"id": "initialize-accepts-2025-11-25", "spec": "2025-11-25 Lifecycle › Version negotiation", "kind": "spec", "rule": "A server that supports the version the client asks for answers with that version (2025-11-25).", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-11-25", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"at": {"protocolVersion": "2025-11-25"}}}},
  {"id": "initialize-accepts-2025-06-18", "spec": "2025-06-18 Lifecycle › Version negotiation", "kind": "spec", "rule": "A server that supports the version the client asks for answers with that version (2025-06-18).", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"at": {"protocolVersion": "2025-06-18"}}}},
  {"id": "initialize-accepts-2025-03-26", "spec": "2025-03-26 Lifecycle › Version negotiation", "kind": "spec", "rule": "A server that supports the version the client asks for answers with that version (2025-03-26).", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-03-26", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"at": {"protocolVersion": "2025-03-26"}}}},
  {"id": "initialize-accepts-2024-11-05", "spec": "2025-03-26 Lifecycle › Version negotiation", "kind": "spec", "rule": "A server that supports the version the client asks for answers with that version (2024-11-05).", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2024-11-05", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"at": {"protocolVersion": "2024-11-05"}}}},
  {"id": "initialize-offers-latest-for-unknown-version", "spec": "2025-11-25 Lifecycle › Version negotiation", "kind": "spec", "rule": "For a version it does not support the server answers with one it does, the latest.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "1999-01-01", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"at": {"protocolVersion": "2025-11-25"}}}},
  {"id": "initialize-answers-with-info-and-capabilities", "spec": "2025-06-18 Lifecycle › Initialization", "kind": "spec", "rule": "The answer carries protocolVersion, capabilities and serverInfo (name, version); instructions are optional text.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"has": ["protocolVersion", "capabilities", "serverInfo.name", "serverInfo.version", "instructions"]}}},
  {"id": "capabilities-claim-no-list-changed", "spec": "2025-06-18 Server › Tools, Resources, Prompts › Capabilities", "kind": "spec", "rule": "listChanged says the server will send a list-changed notification. This server never sends one (each HTTP request is its own stateless server), so it does not claim to.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"result": {"absent": ["capabilities.tools.listChanged", "capabilities.resources.listChanged", "capabilities.prompts.listChanged", "capabilities.resources.subscribe"], "has": ["capabilities.tools", "capabilities.resources", "capabilities.prompts"]}}},
  {"id": "initialize-without-protocol-version-is-invalid-params", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "Params that fail the request's schema are -32602 Invalid params, not an internal error.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"capabilities": {}, "clientInfo": {"name": "x", "version": "1"}}}, "expect": {"error": -32602}},
  {"id": "ping-answers-an-empty-result", "spec": "2025-06-18 Utilities › Ping", "kind": "spec", "rule": "A ping request is answered promptly with an empty result.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 2, "method": "ping"}, "expect": {"result": {"equals": {}}}},
  {"id": "response-echoes-a-string-id", "spec": "2025-06-18 Base › Requests", "kind": "spec", "rule": "The response carries the id of the request, string or number.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": "abc-1", "method": "ping"}, "expect": {"result": {"equals": {}}}},
  {"id": "initialized-notification-gets-no-answer", "spec": "2025-06-18 Base › Notifications", "kind": "spec", "rule": "A notification has no response.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "method": "notifications/initialized"}, "expect": {"none": true}},
  {"id": "unknown-notification-gets-no-answer", "spec": "2025-06-18 Base › Notifications", "kind": "spec", "rule": "A notification the server does not know is ignored, never answered with an error.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "method": "notifications/not-a-thing"}, "expect": {"none": true}},
  {"id": "cancelling-an-unknown-request-is-ignored", "spec": "2025-06-18 Utilities › Cancellation", "kind": "spec", "rule": "A cancellation for a request that is not in progress is ignored (receivers MAY ignore it).", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "method": "notifications/cancelled", "params": {"requestId": 987654, "reason": "test"}}, "expect": {"none": true}},
  {"id": "progress-for-no-request-is-ignored", "spec": "2025-06-18 Utilities › Progress", "kind": "spec", "rule": "A progress notification for a token the receiver did not issue is ignored.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "method": "notifications/progress", "params": {"progressToken": "nope", "progress": 1}}, "expect": {"none": true}},
  {"id": "progress-token-on-a-request-is-accepted", "spec": "2025-06-18 Utilities › Progress", "kind": "spec", "rule": "A request may carry _meta.progressToken; the receiver may send progress notifications for it, and this server sends none. The request is answered as usual.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 12, "method": "tools/call", "params": {"name": "list_databases", "arguments": {}, "_meta": {"progressToken": "p1"}}}, "expect": {"result": {"at": {"content.0.type": "text"}}}},
  {"id": "unknown-method-is-method-not-found", "spec": "2025-06-18 Base › Responses; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "A method the server does not have is -32601.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 3, "method": "nope/x"}, "expect": {"error": -32601}},
  {"id": "logging-is-not-offered", "spec": "2025-06-18 Server › Utilities › Logging", "kind": "spec", "rule": "logging/setLevel works only on a server that declares the logging capability; this one does not, so it is method-not-found.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 3, "method": "logging/setLevel", "params": {"level": "info"}}, "expect": {"error": -32601}},
  {"id": "tools-list-returns-one-page", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "tools/list returns every item and no nextCursor: the lists are short enough for one page.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "tools/list"}, "expect": {"result": {"has": ["tools"], "absent": ["nextCursor"]}}},
  {"id": "tools-list-refuses-a-cursor", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "A cursor this server did not issue is -32602 Invalid params (tools/list); it issues none.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "tools/list", "params": {"cursor": "bogus"}}, "expect": {"error": -32602}},
  {"id": "resources-list-returns-one-page", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "resources/list returns every item and no nextCursor: the lists are short enough for one page.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "resources/list"}, "expect": {"result": {"has": ["resources"], "absent": ["nextCursor"]}}},
  {"id": "resources-list-refuses-a-cursor", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "A cursor this server did not issue is -32602 Invalid params (resources/list); it issues none.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "resources/list", "params": {"cursor": "bogus"}}, "expect": {"error": -32602}},
  {"id": "resources-templates-list-returns-one-page", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "resources/templates/list returns every item and no nextCursor: the lists are short enough for one page.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "resources/templates/list"}, "expect": {"result": {"has": ["resourceTemplates"], "absent": ["nextCursor"]}}},
  {"id": "resources-templates-list-refuses-a-cursor", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "A cursor this server did not issue is -32602 Invalid params (resources/templates/list); it issues none.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "resources/templates/list", "params": {"cursor": "bogus"}}, "expect": {"error": -32602}},
  {"id": "prompts-list-returns-one-page", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "prompts/list returns every item and no nextCursor: the lists are short enough for one page.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "prompts/list"}, "expect": {"result": {"has": ["prompts"], "absent": ["nextCursor"]}}},
  {"id": "prompts-list-refuses-a-cursor", "spec": "2025-06-18 Server › Utilities › Pagination", "kind": "spec", "rule": "A cursor this server did not issue is -32602 Invalid params (prompts/list); it issues none.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 4, "method": "prompts/list", "params": {"cursor": "bogus"}}, "expect": {"error": -32602}},
  {"id": "tools-call-unknown-tool-is-a-protocol-error", "spec": "2025-06-18 Server › Tools › Error handling", "kind": "spec", "rule": "An unknown tool is a JSON-RPC protocol error (-32602), not a tool result.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "no_such_tool", "arguments": {}}}, "expect": {"error": -32602}},
  {"id": "tools-call-without-params-is-invalid-params", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "tools/call with no params is -32602, not an internal error that prints a schema check.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 5, "method": "tools/call"}, "expect": {"error": -32602, "errorMessageNot": "expected|\\[\\s*\\{"}},
  {"id": "tools-call-name-must-be-text", "spec": "2025-06-18 Server › Tools › Calling tools", "kind": "spec", "rule": "The tool name is a string.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": 7}}, "expect": {"error": -32602}},
  {"id": "tools-call-bad-arguments-is-a-tool-error", "spec": "2025-11-25 Server › Tools › Error handling", "kind": "spec", "rule": "Input that fails the tool's schema is a tool execution error (isError true with the reason as text) so the model can correct it, not a protocol error.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "describe_database", "arguments": {}}}, "expect": {"result": {"at": {"isError": true, "content.0.type": "text"}}}},
  {"id": "tools-call-answers-with-content", "spec": "2025-06-18 Server › Tools › Tool result", "kind": "spec", "rule": "A call returns a content list; text content is {type: text, text}.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 5, "method": "tools/call", "params": {"name": "list_databases", "arguments": {}}}, "expect": {"result": {"at": {"content.0.type": "text"}, "has": ["content.0.text"], "absent": ["isError"]}}},
  {"id": "resources-read-unknown-uri-is-not-found", "spec": "2025-06-18 Server › Resources › Error handling", "kind": "spec", "rule": "A resource that does not exist is -32002 Resource not found, with the uri in data.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 6, "method": "resources/read", "params": {"uri": "nope://x"}}, "expect": {"error": -32002, "errorData": {"uri": "nope://x"}}},
  {"id": "resources-read-unknown-database-is-not-found", "spec": "2025-06-18 Server › Resources › Error handling", "kind": "spec", "rule": "A resource of a file that is not hosted is -32002 as well.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 6, "method": "resources/read", "params": {"uri": "tabularius://NoSuchFile/schema"}}, "expect": {"error": -32002, "errorData": {"uri": "tabularius://NoSuchFile/schema"}}},
  {"id": "resources-read-without-uri-is-invalid-params", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "resources/read needs a uri.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 6, "method": "resources/read", "params": {}}, "expect": {"error": -32602}},
  {"id": "prompts-get-unknown-prompt-is-invalid-params", "spec": "2025-06-18 Server › Prompts › Error handling", "kind": "spec", "rule": "An invalid prompt name is -32602.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 7, "method": "prompts/get", "params": {"name": "no_such_prompt"}}, "expect": {"error": -32602}},
  {"id": "prompts-get-without-name-is-invalid-params", "spec": "2025-06-18 Server › Prompts › Error handling", "kind": "spec", "rule": "prompts/get needs a name.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 7, "method": "prompts/get", "params": {}}, "expect": {"error": -32602}},
  {"id": "completion-for-unknown-prompt-is-invalid-params", "spec": "2025-06-18 Server › Utilities › Completion › Error handling", "kind": "spec", "rule": "A completion for a prompt that does not exist is -32602.", "transports": ["http", "stdio"], "message": {"jsonrpc": "2.0", "id": 8, "method": "completion/complete", "params": {"ref": {"type": "ref/prompt", "name": "no_such_prompt"}, "argument": {"name": "database", "value": ""}}}, "expect": {"error": -32602}},
  {"id": "http-invalid-json-is-parse-error", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "Text that is not JSON is -32700 Parse error with a null id (JSON-RPC 2.0 §5.1).", "transports": ["http"], "body": "{nope", "expect": {"status": 400, "error": -32700, "nullId": true}},
  {"id": "http-missing-jsonrpc-is-invalid-request", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "A message without \"jsonrpc\": \"2.0\" is -32600 Invalid Request.", "transports": ["http"], "body": "{\"id\":1,\"method\":\"ping\"}", "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-null-id-is-invalid-request", "spec": "2025-06-18 Base › Requests", "kind": "spec", "rule": "A request id is a string or a number, never null.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": null, "method": "ping"}, "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-method-must-be-text", "spec": "2025-06-18 Base › Requests", "kind": "spec", "rule": "A method is a string.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": 5}, "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-message-must-be-an-object", "spec": "2025-06-18 Base › Messages; JSON-RPC 2.0 §5.1", "kind": "spec", "rule": "A message is an object (a bare number or string is not one).", "transports": ["http"], "body": "5", "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-empty-batch-is-invalid-request", "spec": "JSON-RPC 2.0 §6", "kind": "spec", "rule": "An empty array is not a message.", "transports": ["http"], "body": "[]", "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-batch-with-a-bad-message-is-invalid-request", "spec": "JSON-RPC 2.0 §6", "kind": "spec", "rule": "One bad message in an array refuses the array.", "transports": ["http"], "message": [{"jsonrpc": "2.0", "id": 1, "method": "ping"}, {"id": 2, "method": "ping"}], "expect": {"status": 400, "error": -32600, "nullId": true}},
  {"id": "http-notification-is-accepted-with-202", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "spec", "rule": "A POST of only notifications or responses is answered 202 Accepted with no body.", "transports": ["http"], "message": {"jsonrpc": "2.0", "method": "notifications/initialized"}, "expect": {"status": 202, "none": true}},
  {"id": "http-response-message-is-accepted-with-202", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "spec", "rule": "A POST of a response (from a client answering a server request) is answered 202 Accepted with no body.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 9, "result": {}}, "expect": {"status": 202, "none": true}},
  {"id": "http-request-is-answered-with-json", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "spec", "rule": "A request is answered with application/json (or an event stream); this server uses JSON.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "expect": {"status": 200, "contentType": "application/json", "result": {"equals": {}}}},
  {"id": "http-unsupported-protocol-header-is-400", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "An unsupported MCP-Protocol-Version header is 400 Bad Request.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": "1999-01-01"}, "expect": {"status": 400}},
  {"id": "http-protocol-header-2025-11-25-is-served", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "A supported MCP-Protocol-Version header is served.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": "2025-11-25"}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-protocol-header-2025-06-18-is-served", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "A supported MCP-Protocol-Version header is served.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": "2025-06-18"}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-protocol-header-2025-03-26-is-served", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "A supported MCP-Protocol-Version header is served.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": "2025-03-26"}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-protocol-header-2024-11-05-is-served", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "A supported MCP-Protocol-Version header is served.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": "2024-11-05"}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-no-protocol-header-assumes-2025-03-26", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Protocol version header", "kind": "spec", "rule": "Without the header the server assumes 2025-03-26 and serves the request.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-protocol-version": null}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-unneeded-session-id-is-ignored", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Session management", "kind": "choice", "rule": "The server never issues an Mcp-Session-Id (each request stands alone), so one a client sends is not required to match anything.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"mcp-session-id": "left-over"}, "expect": {"status": 200, "result": {"equals": {}}}},
  {"id": "http-does-not-issue-a-session-id", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Session management", "kind": "choice", "rule": "Session ids are optional (the server MAY assign one); this server assigns none.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {"protocolVersion": "2025-06-18", "capabilities": {}, "clientInfo": {"name": "conformance", "version": "1"}}}, "expect": {"status": 200, "noHeader": "mcp-session-id"}},
  {"id": "http-foreign-origin-is-403", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Security warning", "kind": "spec", "rule": "A request whose Origin is not the server's own is 403 Forbidden (DNS rebinding protection).", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"origin": "https://evil.example"}, "expect": {"status": 403, "error": -32000, "nullId": true}},
  {"id": "http-put-is-405", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "choice", "rule": "A method the endpoint does not serve is 405.", "transports": ["http"], "method": "PUT", "expect": {"status": 405}},
  {"id": "http-get-without-event-stream-accept-is-406", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "choice", "rule": "GET opens an event stream, so it must accept one.", "transports": ["http"], "method": "GET", "headers": {"accept": "application/json"}, "expect": {"status": 406}},
  {"id": "http-get-opens-a-stream-or-is-405", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Listening for messages", "kind": "spec", "rule": "GET answers with an event stream or 405 Method Not Allowed.", "transports": ["http"], "method": "GET", "headers": {"accept": "text/event-stream"}, "expect": {"statusAnyOf": [200, 405], "stream": true}},
  {"id": "http-delete-ends-nothing-or-is-405", "spec": "2025-06-18 Base › Transports › Streamable HTTP › Session management", "kind": "spec", "rule": "DELETE ends a session; with none to end the server answers 200 or 405 (which the spec allows).", "transports": ["http"], "method": "DELETE", "expect": {"statusAnyOf": [200, 204, 405]}},
  {"id": "http-post-must-accept-json-and-event-stream", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "choice", "rule": "The client lists both application/json and text/event-stream in Accept; a POST that does not is refused (406).", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"accept": "application/json"}, "expect": {"status": 406}},
  {"id": "http-post-must-send-json", "spec": "2025-06-18 Base › Transports › Streamable HTTP", "kind": "choice", "rule": "A POST body is application/json; anything else is 415.", "transports": ["http"], "message": {"jsonrpc": "2.0", "id": 1, "method": "ping"}, "headers": {"content-type": "text/plain"}, "expect": {"status": 415}},
  {"id": "stdio-line-that-is-not-json-is-ignored", "spec": "2025-06-18 Base › Transports › stdio", "kind": "choice", "rule": "A line that is not JSON gets no answer and the server carries on (the specification sets no reply for it).", "transports": ["stdio"], "line": "this is not json", "expect": {"none": true}},
